# Server-only Google Web Services key. Do not enable for this sales workflow until
# your license/terms review confirms storage, export, scoring, and drafting rights.
GOOGLE_MAPS_API_KEY=
ENABLE_GOOGLE_PLACES=false

# Optional server-only OpenAI-compatible endpoint for profile / outreach drafting.
RESEARCH_API_KEY=
RESEARCH_MODEL=
RESEARCH_BASE_URL=

# Default live business discovery uses RapidAPI Local Business Data when configured,
# otherwise public Nominatim/Photon geocoding and Overpass.
# Add a contact email to comply with Nominatim's identification guidance.
OSM_CONTACT_EMAIL=
OVERPASS_API_URL=https://overpass-api.de/api/interpreter

# RapidAPI Local Business Data (preferred nearby business provider).
RAPIDAPI_KEY=
RAPIDAPI_HOST=local-business-data.p.rapidapi.com

# Official FCC fixed-availability index. Download FCC state CSVs through your FCC
# account, unzip them, then run `npm run fcc:import -- ...` as documented in README.
FCC_USERNAME=
FCC_HASH_VALUE=
FCC_AVAILABILITY_DB_PATH=

# Optional commercial Fabric address matching for exact FCC Location IDs.
# Without this, ProspectIQ can only show official H3-area observations.
COSTQUEST_API_TOKEN=
COSTQUEST_MATCH_MIN_SIMILARITY=0.95

# Explicit opt-in only. The normal default is live OpenStreetMap data.
USE_DEMO_DATA=false

# Public GitHub link shown on the landing header.
NEXT_PUBLIC_GITHUB_URL=https://github.com/sforskeezy/findbiz

# Optional database connection for later phases.
DATABASE_URL=
