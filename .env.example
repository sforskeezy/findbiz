# PAI Places is FindBiz's own first-party discovery API (/api/places/*).
# It needs no API key. It uses public geocoders (US Census, Photon, Nominatim)
# and OpenStreetMap via Overpass, plus an optional local cache file you maintain.

# Contact address sent to OSM services so they can reach you about traffic.
OSM_CONTACT_EMAIL=
OVERPASS_API_URL=https://overpass-api.de/api/interpreter

# Businesses you add yourself when public map data is missing them.
# Copy data/places-cache.example.json to data/places-cache.json to get started.
PAI_PLACES_CACHE_PATH=data/places-cache.json

# Optional server-only profile / outreach drafting (Claude Opus 5 recommended).
# Anthropic Messages API:
#   RESEARCH_API_KEY=sk-ant-...
#   RESEARCH_MODEL=claude-opus-5
#   RESEARCH_BASE_URL=https://api.anthropic.com/v1
# Or any OpenAI-compatible proxy that serves Claude Opus 5.
RESEARCH_API_KEY=
RESEARCH_MODEL=claude-opus-5
RESEARCH_BASE_URL=https://api.anthropic.com/v1

# --- First-party Google Maps scraper ------------------------------------------
# Keyless server-side scraper for Google Maps public search pages. It extracts
# public listing data into /api/maps/search and is the primary /api/research feed.
ENABLE_GOOGLE_MAPS_SCRAPER=true
GOOGLE_MAPS_SCRAPER_MAX_QUERIES=28
GOOGLE_MAPS_SCRAPER_CONCURRENCY=2
GOOGLE_MAPS_SCRAPER_DELAY_MS=250
GOOGLE_MAPS_SCRAPER_CACHE_TTL_SECONDS=900

# Optional comma-separated replacement for the default 28 discovery keywords.
GOOGLE_MAPS_SCRAPER_QUERIES=

# Optional official Google Places enrichment. Not required by the scraper.
ENABLE_GOOGLE_PLACES=false
GOOGLE_MAPS_API_KEY=

# Optional licensed Google Maps data provider; also merged when enabled.
ENABLE_RAPIDAPI_PLACES=false
RAPIDAPI_KEY=
RAPIDAPI_HOST=maps-data.p.rapidapi.com

# Optional indexed-web research. Google Custom Search JSON API is available only
# to existing customers and is scheduled to end January 1, 2027. The selected
# company's public website is still researched when these values are empty.
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_ENGINE_ID=

# First-party Google research engine used on the Evidence tab. It plans identity,
# registry, contact, and news queries, then falls back to a keyless index when
# Google's public search page is JavaScript-gated. This does not change Maps.
GOOGLE_RESEARCH_MAX_QUERIES=9
GOOGLE_RESEARCH_CONCURRENCY=2
GOOGLE_RESEARCH_DELAY_MS=200
GOOGLE_RESEARCH_CACHE_TTL_SECONDS=900
ENABLE_GOOGLE_SEARCH_SCRAPER=true
ENABLE_BING_SEARCH_FALLBACK=true
ENABLE_KEYLESS_WEB_SEARCH_FALLBACK=true

# Optional comma-separated domains to constrain Google web research, for example
# a state business registry and a trusted trade directory. Empty means the
# configured Programmable Search Engine decides its own search scope.
RESEARCH_SEARCH_DOMAINS=

# Official FCC fixed-availability index. Download FCC state CSVs through your FCC
# account, unzip them, then run `npm run fcc:import -- ...` as documented in README.
FCC_USERNAME=
FCC_HASH_VALUE=
FCC_AVAILABILITY_DB_PATH=

# Optional commercial Fabric address matching for exact FCC Location IDs.
# Without this, ProspectIQ can only show official H3-area observations.
COSTQUEST_API_TOKEN=
COSTQUEST_MATCH_MIN_SIMILARITY=0.95

# Explicit opt-in only.
USE_DEMO_DATA=false

# Public GitHub link shown on the landing header.
NEXT_PUBLIC_GITHUB_URL=https://github.com/sforskeezy/findbiz

# Radar Mode territory memory. Snapshots live on disk so later scans can detect change.
RADAR_STORE_PATH=data/radar
RADAR_MAX_ENRICH=12
RADAR_ENRICH_CONCURRENCY=2

# Live Mode chat assistant. Qwen 3.5 Flash (Alibaba DashScope) is the default;
# Groq is the fallback when Qwen is unset or failing, and Qwen is used when Groq
# is rate-limited or out of daily quota. Leave both empty and Live still finds
# businesses from the Google Maps scraper (OSM is only a backstop).
# On Netlify/Vercel the store is automatically remapped to /tmp — do not point
# LIVE_STORE_PATH at data/live in production (the Lambda bundle is read-only).
LIVE_STORE_PATH=data/live
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen3.5-flash
# Voice input in Live uses the same DashScope key. US endpoints want qwen3-asr-flash-us.
QWEN_ASR_MODEL=qwen3-asr-flash
LIVE_MODEL=openai/gpt-oss-120b
LIVE_BASE_URL=https://api.groq.com/openai/v1

# Optional Groq briefing for Radar (one cheap call per scan). Leave empty to use the
# deterministic briefing, which never invents businesses. Do not point this at Claude.
GROQ_API_KEY=
RADAR_BRIEF_MODEL=llama-3.1-8b-instant
RADAR_BRIEF_BASE_URL=https://api.groq.com/openai/v1

# Optional database connection for later phases.
DATABASE_URL=
