# Local Overture Maps Places GeoParquet file or directory. Keep bulk data out of Git.
OVERTURE_PLACES_PATH=data/overture/places.parquet
# Exact WEST,SOUTH,EAST,NORTH boundary used to prepare the bounded extract.
OVERTURE_COVERAGE_BBOX=

# Public OpenStreetMap services. Use an operator contact and conservative budget.
OSM_CONTACT_EMAIL=
OVERPASS_API_URL=https://overpass.private.coffee/api/interpreter
OVERPASS_MAX_REQUESTS=8

# Optional server-only commercial provider adapter. It remains disabled unless
# every value is set and a reviewed contract expressly permits the intended use.
COMMERCIAL_PROVIDER_ID=
COMMERCIAL_PROVIDER_LABEL=
COMMERCIAL_PROVIDER_BASE_URL=
COMMERCIAL_PROVIDER_API_KEY=
COMMERCIAL_PROVIDER_ATTRIBUTION_URL=
COMMERCIAL_PROVIDER_RETENTION_RULE=
COMMERCIAL_PROVIDER_LICENSE_ACK=

# Optional server-only research brief model. The browser never receives this key.
RESEARCH_API_KEY=
RESEARCH_MODEL=
RESEARCH_BASE_URL=

# Current official FCC Broadband Data Collection local index.
FCC_AVAILABILITY_DB_PATH=

# Optional separately licensed Fabric full-address matching.
COSTQUEST_API_TOKEN=
COSTQUEST_API_BASE_URL=https://api.costquest.com
COSTQUEST_MATCH_MIN_SIMILARITY=0.95

# Optional strict numeric FCC provider IDs used for provider-specific context.
CHARTER_FCC_PROVIDER_IDS=

NEXT_PUBLIC_GITHUB_URL=https://github.com/sforskeezy/findbiz
